{
  "name": "procmetrix",
  "version": "1.0.0",
  "license": "MIT",
  "author": {
    "name": "Luiz Gustavo Pfitscher e Feldmann"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizfeldmann/procmetrix"
  },
  "scripts": {
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "build": "vite build",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "conan:build": "conan build . --profile=default --profile=conan/profiles/nodejs-bindings",
    "cmake:install": "cmake --install build/Release --component=NodeBinding --prefix=dist",
    "postinstall": "npm run conan:build && npm run cmake:install"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "linux",
    "win32",
    "freebsd"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "glob": "^13.0.6",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "CMakeLists.txt",
    "conanfile.py",
    "conan/profiles/nodejs-bindings",
    "src",
    "include",
    "bindings/nodejs/CMakeLists.txt",
    "bindings/nodejs/src",
    "dist/**/*.{js,cjs,d.ts,map}"
  ]
}
