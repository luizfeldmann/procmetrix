{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,

    "types": ["node"],

    "paths": {
      "@/*": ["./bindings/nodejs/lib/*"]
    }
  },
  "include": ["bindings/nodejs/lib/**/*.ts", "bindings/nodejs/tests/**/*.ts"]
}
